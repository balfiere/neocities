{% assign coll = collections[collection] %}{% assign collsort = collections[collectionSort] %}<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="generator" content="{{ eleventy.generator }}">
    <link rel="stylesheet" href="/media/media.css">
    <link rel="alternate" title="ราวเหมือนดั่งความฝัน: updates" type="application/atom+xml" href="https://kwaamfan.haliya.net/atom.xml"/>

    <style>
        {% assign categoriesAlpha = coll | extractKeyWithCount: "categories", "alpha" %}{% for category in categoriesAlpha %}
        form:has([name="{{ category.name | slugify }}"]:checked)~#image-grid-container section:not([category~="{{ category.name | slugify }}"]){% unless forloop.last %}, {% endunless %}{% endfor %} {
            display: none;
        }
    </style>
</head>

<body>
    <header>
        <h1>/<a href="/main">home</a> /<a href="/media/books">books</a></h1>
    </header>
    <main>

        <!-- for every category you use, you must add a new checkbox -->

        {% assign categoriesSorted = coll | extractKeyWithCount: "categories", "count" %}
        <form>{% for category in categoriesSorted %}
            <label><input type="checkbox" name="{{ category.name | slugify }}">#{{ category.name }} ({{ category.count }})</label>{% endfor %}
        </form>

        <!-- image gallery starts here -->

        <div id="image-grid-container">

            {% for entry in collsort %}

            <section category="{% for category in entry.data.categories %}{{ category | slugify }} {% endfor %}"{% if entry.data.notes %} data-tippy-content="{{ entry.data.notes | markdownify-inline }}"{% endif %}>
                    <div class="img-box">
                        <img src="images/{{ entry.data.cover | basename }}" />
                        <div class="transparent-box">
                            <span class="caption">
                                <h2><span>{{ entry.data.englishTitle }}</span></h2>
                                <h3><span>{% for author in entry.data.author %}{{ author }}{% unless forloop.last %}, {% endunless %}{% endfor %}</span></h3>
                                <p><span>{{ entry.data.year }}</span></p>
                            </span>
                        </div>
                    </div>
            </section>

            {% endfor %}

        </div>
    </main>

<!--- tooltips -->
<script src="https://unpkg.com/@popperjs/core@2"></script>
<script src="https://unpkg.com/tippy.js@6"></script>
<script>
    tippy('[data-tippy-content]',{
        followCursor: true,
        animateFill: false,
        animation: 'scale-subtle',
        placement: 'right',
        arrow: true,
        offset: [0, 20],
        allowHTML: true,
        theme: 'mine'
    } );
</script>

</body>

</html>