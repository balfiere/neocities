<!-- start navigation collapsed when in mobile view -->
<script>
  var sidebarDetails = document.querySelectorAll("#side details");

  const mediaQuery = window.matchMedia('(max-width: 900px)')

  if(mediaQuery.matches) {
    sidebarDetails.forEach((detail) => {
      detail.open = false;
    });
  }
</script>
